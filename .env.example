# Copiar a .env y cambiar estos valores para cada entorno.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://agrosense:agrosense_local@localhost:5432/agrosense?schema=public
POSTGRES_USER=agrosense
POSTGRES_PASSWORD=agrosense_local
POSTGRES_DB=agrosense
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=

# Secretos locales de ejemplo: reemplazarlos antes de cualquier despliegue.
JWT_ACCESS_SECRET=replace_this_local_access_secret_with_32_chars
JWT_REFRESH_SECRET=replace_this_local_refresh_secret_with_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INGEST_API_KEY=replace_this_local_ingest_key_with_32_chars

# SMTP es opcional en desarrollo. Completarlo para habilitar el envío de correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AgroSense <no-reply@agrosense.local>

# Solo para crear usuarios de demostracion en la base local.
DEMO_SEED_PASSWORD=change_this_local_demo_password
